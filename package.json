{
  "name": "imaimai-front-minimal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev",
    "build": "next build",
    "check": "oxlint -c oxlint.config.ts . && oxfmt --check . && tsc --noEmit",
    "check:fix": "oxlint -c oxlint.config.ts --fix . && oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "msw:init": "msw init public --no-save",
    "doctor": "react-doctor --no-telemetry -y"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.1",
    "clsx": "2.1.1",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.103.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.1.0",
    "lefthook": "2.1.14",
    "msw": "2.15.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.14",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@10.19.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
