# Committed defaults. Every VITE_-prefixed value is readable in the built
# bundle, so a credential never goes in one of these files.
VITE_API_BASE_URL=/api

# `off` runs the dev server against the real VITE_API_BASE_URL instead of the
# Mock Service Worker handlers in src/mocks/. Override it in .env.local.
VITE_API_MOCK=on
