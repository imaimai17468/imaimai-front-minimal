# pnpm hoists nothing by default, and the Vite+ binaries (`vp`, `oxlint`,
# `oxfmt`) are reached through `pnpm exec` or a package.json script.
auto-install-peers=true
# Run pnpm audit after every install so known CVEs surface immediately.
audit=true
# Block postinstall scripts — the primary supply-chain attack vector.
# lefthook's `prepare` script is skipped too, so run `pnpm exec lefthook install`
# once after a fresh clone.
ignore-scripts=true
